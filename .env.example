# Copier ce fichier vers .env et renseigner les valeurs localement.
# Ne pas y placer de secrets de production.

# Service MySQL Docker
MYSQL_DATABASE=escadron_du_poil
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Connexion backend (Docker local ou Aiven / Render)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=escadron_du_poil

# Chemin vers le certificat CA Aiven (Secret File Render).
# Laisser vide en développement local / Docker (pas de TLS).
DB_CA_PATH=
